!.env.example

# Install lock / runtime markers
public/install.lock
public/install_step3
storage/install_step3
public/storage
storage/*.key
storage/app/!**
storage/app/.gitignore
storage/app/private/.gitignore
storage/app/public/.gitignore
storage/app/public/avatars/!**
storage/app/public/avatars/.gitignore
storage/debugbar
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/installed
storage/logs/*
storage/pail
yarn-error.log

# 头像目录：保留目录但忽略上传的图片文件
public/avatars/*
!public/avatars/.gitkeep

# vendor 纳入版本库，客户拉取后无需 composer install 即可直接运行
# /vendor
/.fleet
/.idea
/.nova
/.zed